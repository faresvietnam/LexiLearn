# Public browser values from Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"

# Server-only values used by the Vercel image-presign function.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"
# Server-only secret used by /api/ai/analyze to read provider tokens.
SUPABASE_SECRET_KEY="sb_secret_your-key"
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="lexilearn-images"
R2_PUBLIC_BASE_URL="https://images.example.com"
